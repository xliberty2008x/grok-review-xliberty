{
  "name": "grok-review-xliberty",
  "version": "0.0.0",
  "private": true,
  "description": "Private standalone review service runtime.",
  "engines": {
    "node": "22.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:secrets": "node scripts/check-secret-surfaces.mjs",
    "check:ported-tests": "node scripts/verify-ported-tests.mjs",
    "eval:fixture": "node scripts/run-policy-evals.mjs --mode fixture --policy policy/review-policy.json",
    "release:prepare": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "check": "npm run format:check && npm test && npm run check:ported-tests && npm run check:boundaries && npm run check:pins && npm run check:secrets && npm run eval:fixture"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "wrangler": "4.120.0"
  }
}
